{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "padel-yuvi11.vercel.app"
        }
      ],
      "destination": "https://netcamsport.co.il/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "padel-three-theta.vercel.app"
        }
      ],
      "destination": "https://netcamsport.co.il/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.+)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
