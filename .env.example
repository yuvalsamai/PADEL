# Supabase — copy to .env.local and fill with your project values
# (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Server-side only (set these in Vercel → Project → Settings → Environment
# Variables). They must NOT be prefixed with VITE_ so they never ship to the
# browser.
# ---------------------------------------------------------------------------
# Hyp Pay terminal credentials
HYP_MASOF=your-terminal-number
HYP_APIKEY=your-hyp-api-key
HYP_PASSP=your-hyp-api-password
# Supabase service-role key (full DB access — server only, never exposed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Telegram order alerts
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# Fixed product price (server enforces this; the client cannot change it)
PRODUCT_PRICE=89
# Secret that unlocks a test amount via /pay?amount=7&token=THIS-VALUE.
# Leave UNSET in production so no one can charge a custom amount.
TEST_AMOUNT_TOKEN=
