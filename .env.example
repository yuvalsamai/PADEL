# Supabase — copy to .env.local and fill with your project values
# (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps — address autocomplete on the /pay checkout form.
# Enable "Maps JavaScript API" + "Places API (New)" and restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
